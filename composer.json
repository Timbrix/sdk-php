{
  "name": "timbrix/sdk-php",
  "description": "SDK de PHP para la API de facturación electrónica CFDI 4.0 de Timbrix",
  "type": "library",
  "license": "MIT",
  "homepage": "https://timbrix.mx",
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Timbrix\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Timbrix\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix"
  }
}
